# ==========================================================
# DaNang SmartTour AI — Environment Configuration Template
# Sao chép file này thành .env và điền các khóa API của bạn
# Copy this file to .env and fill in your credentials
# ==========================================================

# 1. VokeAPI Configuration (OpenAI-compatible AI Service)
# Lấy API Key tại: https://vokeapi.com
VOKE_API_KEY=your-vokeapi-key-here
VOKE_BASE_URL=https://api.vokeapi.com/v1
VOKE_MODEL=deepseek-v4-pro

# 2. Supabase Configuration (PostgreSQL Database & Auth)
# Lấy URL và Anon Key tại: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
